# Veritas Credit Underwriting Portal - Environment Configuration Template
# Copy this file to .env and configure for your environment

# Flask Server Port
PORT=5000

# Environment Mode: 'production' or 'development'
FLASK_ENV=production

# Flask Debug Flag (0 = disabled, 1 = enabled)
FLASK_DEBUG=0

# Secret Key for Session & Cookie Signing
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Maximum Bank Statement Upload Limit in Megabytes
MAX_UPLOAD_MB=10

